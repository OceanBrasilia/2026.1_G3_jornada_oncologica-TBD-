# ==============================================================================
# CONFIGURAÇÕES DO BANCO DE DADOS (DOCKER LOCAL)
# ==============================================================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jornada_db

# String de conexão usada internamente pelo container do backend (aponta para o serviço "db" do compose)
DATABASE_URL=postgresql://postgres:postgres@db:5432/jornada_db

# ==============================================================================
# CONFIGURAÇÃO DO BANCO DE DADOS EXTERNO (VM OCEAN / AGHU DE HOMOLOGAÇÃO)
# Para apontar o backend para a VM externa, comente a linha acima e descomente as linhas abaixo
# preenchendo com as credenciais recebidas, certificando-se de estar na rede HUB.
# ==============================================================================
# DATABASE_URL=postgresql://seu_usuario:sua_senha@ip_da_vm:porta_da_vm/nome_do_banco
